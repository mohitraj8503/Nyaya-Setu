# NyayaSetu 2.0 Environment Configuration

# -------------------------------------------------------------
# Core Server & Environment
# -------------------------------------------------------------
ENV=development
DEBUG=True
PORT=8000
CORS_ORIGINS=["*"]

# -------------------------------------------------------------
# Database & Cache
# -------------------------------------------------------------
# Local development default: SQLite
DATABASE_URL=sqlite:///backend/nyayasetu_v2.db
# Production: PostgreSQL with PostGIS extension
# DATABASE_URL=postgresql://nyayasetu:nyayasetu_dev@localhost:5432/nyayasetu

# Redis for background tasks & Celery
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# AI & Indic Language APIs
# -------------------------------------------------------------
# Set to False to invoke live external APIs; True enables deterministic local simulation
USE_MOCK_AI=True

# Sarvam AI STT & Translation (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM API (OpenAI / Anthropic / Groq / Ollama)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# Indian Notification Gateways
# -------------------------------------------------------------
# Set to False to dispatch real SMS / WhatsApp / SMTP emails
SIMULATION_NOTIFICATIONS=True

# MSG91 SMS Gateway (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=NYASET

# Gupshup WhatsApp Business API (https://gupshup.io)
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_APP_NAME=NyayaSetuGrievance

# SMTP Outbound Dispatch (for Nodal Officer grievance emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=grievance-desk@nyayasetu.org

# -------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------
# Change in production!
JWT_SECRET_KEY=nyayasetu-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
